{
  "name": "@collana-solutions/blueprint-api-kit",
  "version": "0.1.0",
  "description": "Axios and TanStack Query plumbing for an ASP.NET backend: Problem Details error notifications, a preconfigured QueryClient, and Orval client factories",
  "keywords": [
    "axios",
    "tanstack-query",
    "orval",
    "problem-details",
    "csag-blueprint"
  ],
  "license": "MIT",
  "author": "collana solutions AG",
  "homepage": "https://github.com/neolution-ch/csag-blueprint-react/tree/main/packages/blueprint-api-kit#readme",
  "bugs": {
    "url": "https://github.com/neolution-ch/csag-blueprint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolution-ch/csag-blueprint-react.git",
    "directory": "packages/blueprint-api-kit"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@collana-solutions/blueprint-core": "workspace:^"
  },
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/notifications": "^9.0.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-router": "^1.130.0",
    "axios": "^1.7.0",
    "lucide-react": "^1.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "axios": "^1.19.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8"
  }
}
