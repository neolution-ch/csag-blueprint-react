{
  "name": "@collana-solutions/blueprint-realtime",
  "version": "0.3.0",
  "description": "The browser side of the CSAG Blueprint real-time channel: a provider that connects to Azure SignalR with a ticket from the API, and hooks to subscribe to tenant-scoped signals",
  "keywords": [
    "signalr",
    "realtime",
    "react",
    "csag-blueprint"
  ],
  "license": "MIT",
  "author": "collana solutions AG",
  "homepage": "https://github.com/neolution-ch/csag-blueprint-react/tree/main/packages/blueprint-realtime#readme",
  "bugs": {
    "url": "https://github.com/neolution-ch/csag-blueprint-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolution-ch/csag-blueprint-react.git",
    "directory": "packages/blueprint-realtime"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@microsoft/signalr": "^10.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.11",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  }
}
