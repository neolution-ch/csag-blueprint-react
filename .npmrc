# Publishing target is the public npm registry, not GitHub Packages.
#
# This file is load-bearing and must stay committed: changesets decides whether a version is
# already published by following pnpm's own registry resolution, which ignores each package's
# publishConfig.registry. Without the lines below that check would consult the wrong registry.
registry=https://registry.npmjs.org/
@collana-solutions:registry=https://registry.npmjs.org/
